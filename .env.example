# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-key-here"

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"

# Optional. Per-IP request cap on /api/gemini. Defaults to 60.
# RATE_LIMIT_PER_HOUR="60"

# Optional. Injected automatically by most hosts (Render, Railway, Fly, Cloud Run).
# PORT="3000"
